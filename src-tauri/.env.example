# FileClean 环境变量示例
#
# 复制为 .env 后按需修改。.env 已在 .gitignore 中，真实配置不要提交到代码库。
# 所有变量都是可选的 —— 不设置时使用下列默认值。

# 应用数据根目录（数据库 / 日志 / 隔离区 / 导出）
# macOS 默认：~/Library/Application Support/FileClean
# Windows 默认：%APPDATA%/FileClean
# Linux 默认：$XDG_DATA_HOME/fileclean 或 ~/.local/share/fileclean
# FILECLEAN_DATA_DIR=/path/to/data

# 日志级别：trace / debug / info / warn / error
# FILECLEAN_LOG_LEVEL=info

# 日志输出格式：true = JSON 行协议（便于采集），false = 人类可读
# FILECLEAN_LOG_JSON=false

# 默认并发线程数；0 表示按 CPU 核数自动决定
# FILECLEAN_THREADS=0

# 单次扫描的文件数量硬上限，防止误选根目录导致失控
# FILECLEAN_MAX_SCAN_FILES=2000000

# 增量指纹缓存的有效天数，超期自动重算
# FILECLEAN_CACHE_MAX_AGE_DAYS=30

# 系统关键目录保护锁；强烈建议保持 true
# FILECLEAN_PROTECT_SYSTEM_DIRS=true

# 默认清理方式：trash（回收站） / hardlink（硬链接替换） / move（移入隔离区）
# FILECLEAN_DEFAULT_DELETE_MODE=trash

# 显式指定回收站目录。设置后**不再调用系统回收站**，改为把文件移入该目录。
# 适用于 CI / 纯 SSH 会话（系统回收站依赖 Finder 自动化或 XDG 目录，落点不确定），
# 或希望把清理产物集中到一个可审计目录的场景。内容仍然完整保留，可随时搬回。
# FILECLEAN_TRASH_DIR=/path/to/trash

# 单文件走全量哈希的体积上限（字节），超过则只做分块指纹 + 抽样
# FILECLEAN_MAX_FULL_HASH_BYTES=8589934592
