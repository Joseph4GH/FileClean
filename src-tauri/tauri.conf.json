{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileClean",
  "version": "0.1.0",
  "identifier": "com.pcxx.fileclean",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FileClean · 重复文件清理",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 660,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "重复文件扫描与安全清理",
    "longDescription": "FileClean 通过多级哈希、感知哈希与音频指纹识别目录中的重复与相似文件，支持智能保留策略、回收站/硬链接/隔离区安全清理，以及 CSV/HTML/XML 报告导出。",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {}
}
